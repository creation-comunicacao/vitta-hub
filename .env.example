# Configuração pública usada ao gerar os arquivos estáticos. Nunca colocar secrets aqui.
NEXT_PUBLIC_SITE_URL=https://fitnesspersonal.com.br
NEXT_PUBLIC_WHATSAPP=551141465843
NEXT_PUBLIC_CONTACT_EMAIL=vittahub@fitnesspersonal.com.br
NEXT_PUBLIC_STORE_URL=
NEXT_PUBLIC_INSTAGRAM=
SITE_INDEXABLE=false
# Configuração de envio: php/private/config.php, fora da pasta pública.

# Origem HTTPS do PHP (sem /api e sem barra final). Vazio usa a mesma origem.
NEXT_PUBLIC_CONTACT_API_ORIGIN=
# Só preencher com ID real. Analytics depende de consentimento e política publicada.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Token público de verificação do Search Console, quando fornecido.
GOOGLE_SITE_VERIFICATION=

# Origem aprovada da loja, somente depois de validar a migração WBuy.
STORE_REDIRECT_ORIGIN=
